{
  "manifest_version": 3,
  "name": "All Subs",
  "version": "0.1.0",
  "description": "AI captions for any video: uses existing subtitles when they exist, otherwise transcribes and translates locally.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "All Subs" },
  "commands": {
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Toggle All Subs captions panel"
    }
  }
}
